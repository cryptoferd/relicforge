# RC3.3 Sepolia live integration
# Use a disposable Sepolia-only wallet. NEVER use a production/mainnet private key here.

SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
DEPLOYER_PRIVATE_KEY=0xYOUR_DISPOSABLE_SEPOLIA_TEST_PRIVATE_KEY

# Optional: enables automatic source verification during the deployment phase.
ETHERSCAN_API_KEY=

# RelicForge Cloud founder support access (Railway server only).
# Comma-separated EVM wallets. Do not put private keys here.
FOUNDER_WALLETS=0xYOUR_FOUNDER_ADMIN_WALLET